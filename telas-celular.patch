From 4d993886671325d9cb51a52368aa9400ca7a62c3 Mon Sep 17 00:00:00 2001
From: Gustavo Yin <zheyingustavo@gmail.com>
Date: Thu, 5 Nov 2026 22:09:46 -0300
Subject: [PATCH] Deixar as telas boas no celular (RNF04)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Auditoria de 27 telas num celular de 375 px (Playwright):
antes 255 alvos de toque menores que 44 px e 97 campos com fonte menor
que 16 px (o iPhone dá zoom ao tocar); depois, nenhum. Nenhuma tela tinha
rolagem para o lado.

- Corrige o botão principal achatado (24 px) em perfil, esportes, semana e
  exercício: em coluna, o flex: 1 de .actions .btn-primary encolhia a altura
- Menu do topo no celular: uma linha que rola para o lado, itens de 44 px,
  com a borda esmaecida; o topo fixo ficou mais baixo que antes
- Campos com 16 px em todas as telas
- Botões, ícones, chips e links pequenos com 44 px no diário, histórico,
  treinos, registrar treino e telas de conta
- Botões de água dividem a linha em vez de quebrar
- Tudo dentro de @media (max-width: 640px): o computador não muda

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018gcqhbFS5ZxoB1aPpg74fq
---
 .../contas/static/contas/css/acesso.css       |  3 +-
 .../contas/static/contas/css/complementos.css | 50 +++++++++++++++++++
 .../diario/static/diario/css/diario.css       | 15 ++++++
 .../treinos/static/treinos/css/treinos.css    | 18 +++++++
 4 files changed, 85 insertions(+), 1 deletion(-)

diff --git a/BioForm/Banco de Dados/contas/static/contas/css/acesso.css b/BioForm/Banco de Dados/contas/static/contas/css/acesso.css
index 222fe01..8466f7c 100644
--- a/BioForm/Banco de Dados/contas/static/contas/css/acesso.css	
+++ b/BioForm/Banco de Dados/contas/static/contas/css/acesso.css	
@@ -589,5 +589,6 @@ form { display: grid; gap: 18px; }
   .goal strong { font-size: 32px; }
   .onb-top .brand-name small { display: none; }
   .actions { flex-direction: column-reverse; }
-  .actions .btn, .actions .btn-primary { width: 100%; max-width: none; }
+  /* flex: none — em coluna, o flex: 1 de .actions .btn-primary achatava o botão para a altura do texto */
+  .actions .btn, .actions .btn-primary { width: 100%; max-width: none; flex: none; }
 }
diff --git a/BioForm/Banco de Dados/contas/static/contas/css/complementos.css b/BioForm/Banco de Dados/contas/static/contas/css/complementos.css
index aad7dcf..376f148 100644
--- a/BioForm/Banco de Dados/contas/static/contas/css/complementos.css	
+++ b/BioForm/Banco de Dados/contas/static/contas/css/complementos.css	
@@ -83,3 +83,53 @@
 @media (max-width: 640px) {
   .onb-top-inner { flex-wrap: wrap; gap: 8px; }
 }
+
+/* ==========================================================================
+   Celular (RNF04): alvos de toque de 44 px e campos com 16 px
+   (com menos de 16 px o iPhone dá zoom na tela ao tocar no campo)
+   ========================================================================== */
+@media (max-width: 640px) {
+  /* Campos de texto, número, data e listas: 16 px em todas as telas.
+     Os :not() só aumentam a especificidade, para valer também sobre o CSS de cada tela
+     (ex.: .linha .field select), que é carregado depois deste arquivo. */
+  input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]),
+  select:not([multiple]):not([size]):not([hidden]),
+  textarea:not([readonly]):not([disabled]):not([hidden]) { font-size: 16px; }
+
+  /* Menu do topo: uma linha só que rola para o lado, com itens de 44 px.
+     O topo é fixo (sticky), então duas linhas de menu ocupariam espaço demais da tela. */
+  .onb-top:has(.top-nav) { padding: 12px 0 0; }
+  .onb-top-inner:has(.top-nav) { flex-direction: column; align-items: stretch; gap: 4px; margin-bottom: 4px; }
+  .onb-top-inner:has(.top-nav) > .brand { padding: 0 16px; }
+  .top-nav {
+    flex-wrap: nowrap;
+    gap: 0;
+    padding: 0 28px 0 8px;
+    overflow-x: auto;
+    overscroll-behavior-x: contain;
+    scrollbar-width: none;
+    /* esmaece a borda direita: mostra que dá para arrastar e ver Editar perfil e Sair */
+    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
+            mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent);
+  }
+  .top-nav::-webkit-scrollbar { display: none; }
+  .top-nav form { display: flex; flex-shrink: 0; }
+  .top-nav a,
+  .top-nav button {
+    display: inline-flex;
+    align-items: center;
+    flex-shrink: 0;
+    min-height: 44px;
+    padding: 0 12px;
+    font-size: 14px;
+    white-space: nowrap;
+  }
+
+  /* Links de voltar e botões pequenos das telas de conta */
+  .back-link { min-height: 44px; }
+  .btn-sm { height: 44px; }
+
+  /* Links no meio do texto (Esqueci minha senha, Termos de Uso): área de toque maior sem mexer no layout */
+  .options a,
+  .check a { display: inline-block; padding: 12px 0; margin: -12px 0; }
+}
diff --git a/BioForm/Sprint-6/diario-alimentar/diario/static/diario/css/diario.css b/BioForm/Sprint-6/diario-alimentar/diario/static/diario/css/diario.css
index 0860485..1ab0d0d 100644
--- a/BioForm/Sprint-6/diario-alimentar/diario/static/diario/css/diario.css
+++ b/BioForm/Sprint-6/diario-alimentar/diario/static/diario/css/diario.css
@@ -108,3 +108,18 @@
   .tabela-historico td::before { content: attr(data-label); display: block; font-size: 11px; color: var(--text-3); }
   .refeicao-head { flex-direction: column; }
 }
+
+/* ---------- Celular (RNF04): alvos de toque de 44 px ---------- */
+@media (max-width: 640px) {
+  .btn-mini { height: 44px; padding: 0 16px; font-size: 14px; }
+  /* Os botões de água dividem a linha em partes iguais, em vez de quebrar para baixo */
+  .agua-acoes { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); }
+  .agua-acoes .btn-mini { width: 100%; padding: 0 8px; }
+  .btn-remover { width: 44px; height: 44px; margin-right: -6px; }
+  .salvar-combo summary { padding: 13px 0; margin: -4px 0; }
+  .dia-links a { display: inline-block; padding: 12px 4px; margin: -12px -4px; }
+  /* Histórico: o dia inteiro vira o link, em vez de só o texto */
+  .tabela-historico td[data-label="Dia"] a { display: flex; align-items: center; min-height: 44px; font-weight: 600; }
+  .tabela-historico td[data-label="Dia"]::before { display: none; }
+  .tabela-historico td[data-label="Dia"] { grid-column: 1 / -1; }
+}
diff --git a/BioForm/Sprint-7/series-academia/treinos/static/treinos/css/treinos.css b/BioForm/Sprint-7/series-academia/treinos/static/treinos/css/treinos.css
index 1a0bb72..f2c0a38 100644
--- a/BioForm/Sprint-7/series-academia/treinos/static/treinos/css/treinos.css
+++ b/BioForm/Sprint-7/series-academia/treinos/static/treinos/css/treinos.css
@@ -460,3 +460,21 @@ fieldset.exercicio-treino { margin: 0; min-width: 0; }
 @media (max-width: 480px) {
   .registro .segmented { grid-template-columns: repeat(2, 1fr); }
 }
+
+/* ---------- Celular (RNF04): alvos de toque de 44 px ---------- */
+@media (max-width: 640px) {
+  .btn-mini { height: 44px; padding: 0 16px; font-size: 14px; }
+  .btn-icone { width: 44px; height: 44px; }
+  .exercicio-acoes { gap: 8px; }
+  .exercicio-acoes form { gap: 8px; }
+  .linha .field input, .linha .field select { height: 44px; }
+  .linha .field select { padding: 0 6px; }  /* cabe "Repetições" inteiro com a fonte de 16 px */
+  .voltar a { display: inline-block; padding: 12px 0; margin: -12px 0; }
+  .paginas .btn-mini { height: 44px; }
+
+  /* Registrar treino (protótipo): chips, intensidade e botões com 44 px */
+  .registro .chip span { padding: 13px 16px; font-size: 14px; }
+  .registro .seg span { height: 44px; font-size: 14px; }
+  .registro .back, .registro .icon-btn { width: 44px; height: 44px; }
+  .registro .crumb { font-size: 13px; }
+}
