<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>BioForm — Seu treino, sua dieta, seu ciclo, seu ritmo.</title>
  <meta name="description" content="BioForm: um app acadêmico de saúde e bem-estar que reúne treino, dieta, ciclo e ritmo em um só lugar. Em breve.">
  <meta name="theme-color" content="#0B0B0D">

  <!-- Fonte (opcional): se estiver offline, o navegador usa a fonte do sistema -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* ============ VARIÁVEIS (identidade BioForm) ============ */
    :root{
      --bg:#0B0B0D;
      --surface:#141418;
      --surface-2:#1B1B21;
      --line:rgba(255,255,255,.09);
      --text:#FAFAFA;
      --muted:#A4A4AE;
      --flame:#FF5722;
      --flame-light:#FF8A50;
      --flame-deep:#FF3D00;
      --grad:linear-gradient(135deg,var(--flame-light) 0%,var(--flame-deep) 100%);
      --radius:20px;
      --font:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    }

    /* ============ RESET / BASE ============ */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
    body{
      font-family:var(--font);
      background:var(--bg);
      color:var(--text);
      line-height:1.6;
      -webkit-font-smoothing:antialiased;
      overflow-x:hidden;
    }
    img,svg{display:block;max-width:100%}
    a{color:inherit;text-decoration:none}
    :focus-visible{outline:3px solid var(--flame-light);outline-offset:3px;border-radius:12px}

    .container{width:100%;max-width:720px;margin-inline:auto;padding-inline:22px}
    .grad-text{
      background:var(--grad);
      -webkit-background-clip:text;background-clip:text;
      color:transparent;
      padding-bottom:.12em; /* evita cortar letras com perna (g, p, q) */
    }

    /* ============ BOTÕES ============ */
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:10px;
      width:100%;min-height:58px;padding:16px 28px;
      font:inherit;font-weight:700;font-size:1.05rem;letter-spacing:-.01em;
      border:0;border-radius:999px;cursor:pointer;
      transition:transform .25s ease,box-shadow .25s ease,background .25s ease,border-color .25s ease,opacity .25s ease;
    }
    .btn svg{width:20px;height:20px;flex:none}
    .btn-primary{
      background:var(--grad);color:#fff;
      box-shadow:0 12px 34px -10px rgba(255,87,34,.65);
    }
    .btn-primary:active{transform:scale(.98)}
    .btn-secondary{
      background:transparent;color:var(--text);
      border:1.5px solid rgba(255,255,255,.22);
    }
    .btn-secondary:active{transform:scale(.98)}
    .btn[aria-disabled="true"]{opacity:.6;cursor:not-allowed}

    @media (hover:hover){
      .btn-primary:hover{transform:translateY(-3px);box-shadow:0 18px 44px -8px rgba(255,87,34,.85)}
      .btn-secondary:not([aria-disabled="true"]):hover{border-color:var(--flame-light);background:rgba(255,87,34,.1);transform:translateY(-3px)}
    }

    /* ============ HERO ============ */
    .hero{
      position:relative;isolation:isolate;
      min-height:100vh;min-height:100svh;
      display:flex;align-items:center;justify-content:center;
      text-align:center;
      padding:48px 0 40px;
      overflow:hidden;
    }
    .hero::before{ /* névoa laranja */
      content:"";position:absolute;inset:0;z-index:-2;
      background:
        radial-gradient(560px 460px at 50% 30%,rgba(255,87,34,.30),transparent 70%),
        radial-gradient(900px 600px at 50% 110%,rgba(255,87,34,.14),transparent 70%);
    }
    .hero::after{ /* grão sutil */
      content:"";position:absolute;inset:0;z-index:-1;opacity:.06;mix-blend-mode:overlay;pointer-events:none;
      background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    }
    .hero-inner{display:flex;flex-direction:column;align-items:center;gap:0}

    .logo{position:relative;width:104px;height:104px;margin-bottom:28px}
    .logo svg{position:absolute;inset:0;width:100%;height:100%}
    .logo .glow{filter:blur(34px);opacity:.85;transform:scale(1.5);animation:pulse 4.5s ease-in-out infinite}
    .logo .mark{filter:drop-shadow(0 12px 26px rgba(255,87,34,.45))}
    @keyframes pulse{0%,100%{opacity:.65;transform:scale(1.4)}50%{opacity:.95;transform:scale(1.6)}}

    .badge{
      display:inline-flex;align-items:center;gap:8px;
      padding:7px 14px;margin-bottom:22px;
      font-size:.78rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
      color:var(--flame-light);
      background:rgba(255,87,34,.1);border:1px solid rgba(255,87,34,.3);border-radius:999px;
    }
    .badge i{width:7px;height:7px;border-radius:50%;background:var(--flame);animation:blink 1.8s ease-in-out infinite}
    @keyframes blink{50%{opacity:.25}}

    .brand{
      font-size:clamp(3.2rem,16vw,6.5rem);
      font-weight:800;line-height:1;letter-spacing:-.045em;
    }
    .slogan{
      margin-top:18px;
      font-size:clamp(1.15rem,4.8vw,1.6rem);
      font-weight:600;line-height:1.35;letter-spacing:-.02em;
      color:var(--text);max-width:22ch;
    }
    .tagline{
      margin-top:14px;
      font-size:clamp(1rem,3.8vw,1.15rem);
      color:var(--muted);max-width:34ch;
    }
    .hero .btn{margin-top:36px;max-width:380px}

    .scroll-hint{
      position:absolute;left:50%;bottom:20px;transform:translateX(-50%);
      width:26px;height:42px;border:2px solid rgba(255,255,255,.25);border-radius:14px;
    }
    .scroll-hint::after{
      content:"";position:absolute;left:50%;top:8px;width:4px;height:8px;margin-left:-2px;
      background:var(--flame-light);border-radius:2px;animation:scroll 1.8s ease-in-out infinite;
    }
    @keyframes scroll{0%{opacity:0;transform:translateY(0)}30%{opacity:1}100%{opacity:0;transform:translateY(14px)}}

    /* ============ SEÇÕES ============ */
    section.block{padding:84px 0}
    .eyebrow{
      font-size:.8rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
      color:var(--flame-light);margin-bottom:12px;
    }
    h2{
      font-size:clamp(1.9rem,8vw,2.8rem);
      font-weight:800;line-height:1.1;letter-spacing:-.035em;margin-bottom:22px;
    }
    .lead p{color:var(--muted);font-size:1.05rem;margin-bottom:16px}
    .lead p strong{color:var(--text);font-weight:600}

    .features{
      display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:34px;list-style:none;
    }
    .feature{
      background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
      padding:20px 16px;
      transition:transform .3s ease,border-color .3s ease,background .3s ease;
    }
    .feature .ico{
      width:46px;height:46px;border-radius:14px;margin-bottom:14px;
      display:grid;place-items:center;font-size:1.4rem;
      background:rgba(255,87,34,.12);border:1px solid rgba(255,87,34,.25);
    }
    .feature h3{font-size:1.05rem;font-weight:700;letter-spacing:-.02em;margin-bottom:4px}
    .feature p{font-size:.9rem;color:var(--muted);line-height:1.5}
    @media (hover:hover){
      .feature:hover{transform:translateY(-4px);border-color:rgba(255,87,34,.5);background:var(--surface-2)}
    }

    /* Contato */
    .contact{background:linear-gradient(180deg,transparent,rgba(255,87,34,.06) 50%,transparent)}
    .contact-list{display:grid;gap:12px;margin-top:30px}
    .contact-card{
      display:flex;align-items:center;gap:16px;padding:18px;
      background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
      transition:transform .3s ease,border-color .3s ease,background .3s ease;
    }
    .contact-card .ci{
      flex:none;width:50px;height:50px;border-radius:16px;display:grid;place-items:center;
      background:var(--grad);color:#fff;
    }
    .contact-card .ci svg{width:24px;height:24px}
    .contact-card strong{display:block;font-size:1.02rem;letter-spacing:-.01em}
    .contact-card span{display:block;font-size:.9rem;color:var(--muted);word-break:break-word}
    .contact-card .arrow{margin-left:auto;flex:none;width:20px;height:20px;color:var(--muted);transition:transform .3s ease,color .3s ease}
    @media (hover:hover){
      .contact-card:hover{transform:translateY(-3px);border-color:rgba(255,87,34,.55);background:var(--surface-2)}
      .contact-card:hover .arrow{transform:translateX(4px);color:var(--flame-light)}
    }

    .site-cta{text-align:center;padding:0 0 84px}
    .site-cta .btn{max-width:380px}
    .site-cta small{display:block;margin-top:12px;color:var(--muted);font-size:.85rem}

    /* ============ RODAPÉ ============ */
    footer{
      border-top:1px solid var(--line);
      padding:44px 0 calc(36px + env(safe-area-inset-bottom,0px));
      text-align:center;
    }
    .footer-slogan{font-size:1.15rem;font-weight:700;letter-spacing:-.025em;line-height:1.4;max-width:24ch;margin:0 auto}
    .socials{display:flex;justify-content:center;gap:14px;margin:26px 0 22px}
    .socials a{
      width:52px;height:52px;border-radius:50%;display:grid;place-items:center;
      background:var(--surface);border:1px solid var(--line);color:var(--text);
      transition:transform .3s ease,background .3s ease,border-color .3s ease;
    }
    .socials svg{width:22px;height:22px}
    @media (hover:hover){
      .socials a:hover{background:var(--grad);border-color:transparent;transform:translateY(-4px)}
    }
    .copy{font-size:.82rem;color:var(--muted)}

    /* ============ ANIMAÇÃO DE ENTRADA ============ */
    .reveal{opacity:0;transform:translateY(22px);animation:rise .8s cubic-bezier(.2,.7,.2,1) forwards}
    .d1{animation-delay:.05s}.d2{animation-delay:.15s}.d3{animation-delay:.25s}.d4{animation-delay:.35s}.d5{animation-delay:.45s}
    @keyframes rise{to{opacity:1;transform:none}}

    /* ============ TABLET / DESKTOP ============ */
    @media (min-width:720px){
      .container{padding-inline:32px}
      .features{grid-template-columns:repeat(4,1fr)}
      .feature{padding:22px 16px}
      .logo{width:120px;height:120px}
    }

    /* Respeita quem prefere menos movimento */
    @media (prefers-reduced-motion:reduce){
      html{scroll-behavior:auto}
      *,*::before,*::after{animation:none!important;transition:none!important}
      .reveal{opacity:1;transform:none}
    }
  </style>
</head>

<body>

  <!-- Logo reutilizável (SVG) -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="bf-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#FF8A50"/><stop offset="1" stop-color="#FF3D00"/>
      </linearGradient>
      <g id="bf-logo">
        <rect x="4" y="4" width="112" height="112" rx="32" fill="url(#bf-g)"/>
        <path d="M60 26a34 34 0 1 1-30.6 19.2" stroke="#fff" stroke-width="9" stroke-linecap="round" opacity=".95" fill="none"/>
        <path d="M29.4 45.2 24 30l15.6 4.2" stroke="#fff" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <path d="M44 72l11-14 9 9 13-19" stroke="#fff" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </g>
    </defs>
  </svg>

  <main>

    <!-- ================= HERO ================= -->
    <header class="hero">
      <div class="container hero-inner">

        <div class="logo reveal d1" aria-hidden="true">
          <svg class="glow" viewBox="0 0 120 120"><use href="#bf-logo"/></svg>
          <svg class="mark" viewBox="0 0 120 120"><use href="#bf-logo"/></svg>
        </div>

        <p class="badge reveal d1"><i></i> Em breve</p>

        <h1 class="brand reveal d2">Bio<span class="grad-text">Form</span></h1>

        <p class="slogan reveal d3">Seu treino, sua dieta, seu ciclo, seu ritmo.</p>

        <p class="tagline reveal d4">Estamos construindo algo incrível. Seja um dos primeiros a conhecer.</p>

        <!-- CTA principal: rola a página até "Fale Conosco". Troque o href quando tiver uma lista de espera. -->
        <a class="btn btn-primary reveal d5" href="#contato">
          Garanta seu Acesso Antecipado
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
        </a>
      </div>
      <span class="scroll-hint" aria-hidden="true"></span>
    </header>

    <!-- ================= O QUE É O APP ================= -->
    <section class="block" id="sobre" aria-labelledby="sobre-titulo">
      <div class="container">
        <p class="eyebrow">O que é o app?</p>
        <h2 id="sobre-titulo">Tudo o que move o seu corpo, <span class="grad-text">num só lugar.</span></h2>

        <div class="lead">
          <p>O <strong>BioForm</strong> é um projeto acadêmico que nasceu para simplificar a rotina de quem cuida da saúde. Em vez de usar um app para cada coisa, você reúne <strong>treino, dieta, ciclo e ritmo</strong> em uma única experiência, pensada para o seu dia a dia.</p>
          <p>A ideia é simples: entender como o seu corpo funciona para que cada decisão, do que comer ao quanto treinar, faça sentido para <strong>você</strong>. Sem fórmulas prontas, no seu ritmo.</p>
        </div>

        <ul class="features" role="list">
          <li class="feature">
            <div class="ico" aria-hidden="true">🏋️</div>
            <h3>Treino</h3>
            <p>Sua rotina de exercícios organizada.</p>
          </li>
          <li class="feature">
            <div class="ico" aria-hidden="true">🥗</div>
            <h3>Dieta</h3>
            <p>Sua alimentação, do seu jeito.</p>
          </li>
          <li class="feature">
            <div class="ico" aria-hidden="true">🌙</div>
            <h3>Ciclo</h3>
            <p>Seu corpo tem fases. Respeite cada uma.</p>
          </li>
          <li class="feature">
            <div class="ico" aria-hidden="true">⚡</div>
            <h3>Ritmo</h3>
            <p>Tudo no seu tempo, no seu ritmo.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ================= FALE CONOSCO ================= -->
    <section class="block contact" id="contato" aria-labelledby="contato-titulo">
      <div class="container">
        <p class="eyebrow">Fale conosco</p>
        <h2 id="contato-titulo">Ficou com alguma <span class="grad-text">dúvida?</span></h2>
        <p class="lead" style="color:var(--muted);font-size:1.05rem">Quer entrar na lista de acesso antecipado, dar uma sugestão ou saber mais sobre o projeto? Chame a gente, vamos adorar conversar.</p>

        <div class="contact-list">

          <!-- WhatsApp: (21) 98600-7600 -->
          <a class="contact-card" href="https://wa.me/5521986007600?text=Ol%C3%A1!%20Quero%20saber%20mais%20sobre%20o%20BioForm." target="_blank" rel="noopener">
            <span class="ci" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2a9.9 9.9 0 0 0-8.4 15.1L2 22l5-1.6A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3 .96.98-2.9-.2-.3a8.2 8.2 0 1 1 6.72 3.57Zm4.5-6.15c-.25-.12-1.46-.72-1.68-.8-.23-.08-.4-.12-.56.12-.17.25-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.22-1.46-1.37-1.7-.14-.25-.02-.38.1-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.4-.42-.56-.42h-.47c-.16 0-.43.06-.65.31-.23.25-.86.84-.86 2.05 0 1.2.88 2.37 1 2.54.12.16 1.72 2.63 4.18 3.69.58.25 1.04.4 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.46-.6 1.66-1.18.2-.58.2-1.07.14-1.18-.06-.1-.23-.16-.47-.28Z"/></svg>
            </span>
            <span><strong>WhatsApp</strong><span>Fale direto com a equipe</span></span>
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>

          <!-- E-mail de suporte -->
          <a class="contact-card" href="mailto:bioformapp@gmail.com?subject=D%C3%BAvida%20sobre%20o%20BioForm">
            <span class="ci" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg>
            </span>
            <span><strong>E-mail</strong><span>bioformapp@gmail.com</span></span>
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>

        </div>
      </div>
    </section>

    <!-- ================= BOTÃO SECUNDÁRIO ================= -->
    <section class="site-cta" aria-label="Site oficial">
      <div class="container">
        <!--
          Enquanto o projeto não estiver hospedado, o botão fica desativado.
          QUANDO PUBLICAR: troque href="#" pela URL real, remova aria-disabled e tabindex,
          e mude o texto para "Acessar o App".
        -->
        <a class="btn btn-secondary" href="#" aria-disabled="true" tabindex="-1" onclick="return false;">
          Site Oficial · Em breve
        </a>
        <small>Será ativado assim que o app estiver no ar.</small>
      </div>
    </section>

  </main>

  <!-- ================= RODAPÉ ================= -->
  <footer>
    <div class="container">
      <p class="footer-slogan grad-text">Seu treino, sua dieta, seu ciclo, seu ritmo.</p>

      <nav class="socials" aria-label="Redes sociais">
        <!-- Perfis oficiais -->
        <a href="https://www.instagram.com/bioform.app" target="_blank" rel="noopener" aria-label="Instagram do BioForm">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="https://www.tiktok.com/@bioform.app" target="_blank" rel="noopener" aria-label="TikTok do BioForm">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 3c.3 2.4 1.7 3.9 4 4.1v3a7 7 0 0 1-4-1.2v6.2a6 6 0 1 1-6-6c.3 0 .6 0 .9.1v3.2a2.9 2.9 0 1 0 2 2.7V3h3.1Z"/></svg>
        </a>
      </nav>

      <p class="copy">© <span id="ano">2026</span> BioForm · Projeto acadêmico</p>
    </div>
  </footer>

  <script>
    // Atualiza o ano automaticamente (único JS da página, opcional)
    document.getElementById('ano').textContent = new Date().getFullYear();
  </script>
</body>
</html>