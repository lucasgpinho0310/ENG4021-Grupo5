+{% extends 'contas/base_perfil.html' %}
+{% load static bioform treinos_tags %}
+{% block titulo %}Treinar: {{ ficha.nome_ficha }}{% endblock %}
+{% block estilos_extra %}<link rel="stylesheet" href="{% static 'treinos/css/treinos.css' %}">{% endblock %}
