+   ========================================================================== */
+.registro { max-width: 640px; display: flex; flex-direction: column; gap: 16px; }
+.registro .i {
+  width: 16px; height: 16px; flex-shrink: 0;
+  fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
+}
+.registro .crumb { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--text-3); }
+.registro .crumb strong { color: var(--text); font-weight: 600; }
+.registro .back {
+  width: 32px; height: 32px; flex-shrink: 0; display: grid; place-items: center;
+  border-radius: 10px; background: var(--surface); border: 1px solid var(--line); color: var(--text);
+}
+.registro .back:hover { border-color: var(--line-strong); }
+.registro .screen-title { font-size: 24px; line-height: 1.2; font-weight: 700; letter-spacing: -.02em; margin: 0; }
+.registro .screen-sub { margin: 6px 0 0; font-size: 14px; line-height: 1.45; color: var(--text-2); }
+
+.registro .workout-form { display: flex; flex-direction: column; gap: 16px; }
+.rg-field { min-width: 0; margin: 0; padding: 0; border: 0; }
+.rg-field > label, .rg-field > legend {
+  display: block; margin-bottom: 6px; padding: 0; font-size: 12px; font-weight: 500; color: var(--text-2);
+}
+.rg-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
+.rg-msg { display: block; margin-top: 6px; font-size: 12px; color: var(--danger); }
+
+.rg-input {
+  height: 46px; display: flex; align-items: center; gap: 10px; padding: 0 12px;
+  border-radius: 12px; background: var(--surface); border: 1px solid var(--line);
+  transition: border-color .15s, box-shadow .15s;
+}
+.rg-input > .i { color: var(--text-3); transition: color .15s; }
+.rg-input input, .registro textarea {
+  flex: 1; min-width: 0; border: 0; outline: 0; background: transparent;
+  color: var(--text); font: inherit; font-size: 16px; /* evita o zoom automático do iOS */
+}
+.rg-input input { height: 100%; padding: 0; }
+.rg-input input::placeholder, .registro textarea::placeholder { color: var(--text-3); }
+.rg-input input[type="date"], .rg-input input[type="time"] { color-scheme: dark; }
+.rg-input:hover { border-color: var(--line-strong); }
+.rg-input:focus-within { border-color: var(--flame); box-shadow: 0 0 0 3px var(--flame-soft); }
+.rg-input:focus-within > .i { color: var(--flame); }
+.rg-input .unit { font-size: 12px; color: var(--text-3); }
+.rg-erro .rg-input, .rg-erro > textarea { border-color: var(--danger); }
+
+.registro textarea {
+  width: 100%; min-height: 84px; padding: 12px; border-radius: 12px;
+  background: var(--surface); border: 1px solid var(--line); resize: vertical; line-height: 1.45;
+}
+.registro textarea:focus { border-color: var(--flame); box-shadow: 0 0 0 3px var(--flame-soft); }
+
+/* Chips (tipo de treino = esporte) */
+.registro .chips { display: flex; flex-wrap: wrap; gap: 8px; }
+.registro .chip input, .registro .seg input { position: absolute; opacity: 0; pointer-events: none; }
+.registro .chip span {
+  display: block; padding: 9px 14px; border-radius: 999px; background: var(--surface);
+  border: 1px solid var(--line); font-size: 13px; font-weight: 500; color: var(--text-2); cursor: pointer;
+  transition: border-color .15s, background .15s, color .15s;
+}
+.registro .chip span:hover { border-color: var(--line-strong); }
+.registro .chip input:checked + span { background: var(--flame-soft); border-color: var(--flame-line); color: var(--flame); }
+.registro .chip input:focus-visible + span, .registro .seg input:focus-visible + span { outline: 2px solid var(--text); outline-offset: 2px; }
+
+/* Intensidade (segmentado) */
+.registro .segmented {
+  display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: 4px;
+  border-radius: 12px; background: var(--surface); border: 1px solid var(--line);
+}
+.registro .seg span {
+  display: grid; place-items: center; height: 36px; border-radius: 9px;
+  font-size: 13px; font-weight: 500; color: var(--text-2); cursor: pointer; transition: background .15s, color .15s;
+}
+.registro .seg span:hover { color: var(--text); }
+.registro .seg input:checked + span { background: var(--flame); color: #fff; font-weight: 600; }
+
+/* Exercícios */
+.registro .ex-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 8px; }
+.registro .ex-head h2 { font-size: 14px; font-weight: 600; margin: 0; }
+.registro .ex-dica { font-size: 12px; color: var(--text-3); }
+.registro .ex-list { display: flex; flex-direction: column; gap: 10px; }
+.registro .exercise {
+  display: flex; flex-direction: column; gap: 10px; padding: 12px;
+  background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
+}
+.registro .exercise.rg-erro { border-color: var(--danger); }
+.registro .ex-top { display: flex; align-items: center; gap: 8px; }
+.registro .ex-top .rg-input { flex: 1; min-width: 0; background: var(--app-bg); }
+.registro .ex-nums { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
+.registro .ex-nums .rg-input { background: var(--app-bg); padding: 0 10px; gap: 6px; }
+.registro .ex-nums label { display: block; margin-bottom: 4px; font-size: 11px; color: var(--text-3); }
+.registro .icon-btn {
+  width: 36px; height: 36px; flex-shrink: 0; display: grid; place-items: center; border-radius: 10px;
+  border: 1px solid var(--line); background: var(--surface-2); color: var(--text-2); cursor: pointer;
+}
+.registro .icon-btn:hover { border-color: var(--line-strong); color: var(--text); }
+.registro .add-ex {
+  width: 100%; height: 44px; margin-top: 10px; display: flex; align-items: center; justify-content: center; gap: 8px;
+  border-radius: 12px; border: 1px dashed var(--line-strong); background: transparent; color: var(--text-2);
+  font: inherit; font-size: 13px; font-weight: 500; cursor: pointer;
+}
+.registro .add-ex:hover:not(:disabled) { border-color: var(--flame); color: var(--flame); }
+.registro .add-ex:disabled { opacity: .4; cursor: default; }
+.registro .back:focus-visible, .registro .icon-btn:focus-visible, .registro .add-ex:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }
+
+.rg-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
+.rg-actions .btn { width: 100%; }
+
+/* Detalhe do treino: observações */
+.observacoes { margin: 0 0 20px; padding: 14px 16px; font-size: 14px; color: var(--text-2); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
+.observacoes small { display: block; margin-bottom: 4px; font-size: 11px; color: var(--text-3); }
+
+@media (max-width: 480px) {
+  .registro .segmented { grid-template-columns: repeat(2, 1fr); }
+}
