+    <p class="subtitle">Desmarque as séries que não fez e ajuste carga e repetições. Os números já vêm com o que você fez da última vez.</p>
+
+    <form method="post" class="form-treino form-treinar" novalidate>
+      {% csrf_token %}
+      {% include 'contas/_erros_gerais.html' %}
+
+      <section class="block">
+        <div class="grade-3">
+          {% include 'treinos/_campo.html' with campo=form.inicio %}
+          {% include 'treinos/_campo.html' with campo=form.duracao %}
+          {% include 'treinos/_campo.html' with campo=form.intensidade %}
+        </div>
+      </section>
+
+      <ol class="exercicios">
