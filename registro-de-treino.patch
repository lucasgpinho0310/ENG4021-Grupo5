+.sessao-info small { color: var(--text-3); font-size: 13px; }
+.sessao-numeros { display: flex; gap: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
+.sessao-numeros small { display: block; font-size: 11px; font-weight: 500; color: var(--text-3); }
+.paginas { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 16px; font-size: 13px; color: var(--text-2); }
+.resumo-sessao { margin: 0 0 20px; }
+.series-lista { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }
+.series-lista li {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  padding: 6px 12px;
+  font-size: 14px;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+  background: var(--surface-2);
+  border-radius: 9px;
+}
+.series-lista small { font-size: 11px; color: var(--text-3); }
+
+@media (max-width: 720px) {
+  .sessao-card { flex-wrap: wrap; }
+  .sessao-numeros { width: 100%; padding-left: 68px; }
+  .ficha-acoes { flex-wrap: wrap; }
+}
