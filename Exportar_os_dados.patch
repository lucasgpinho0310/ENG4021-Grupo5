+"""
+Exportar meus dados (RNF12 Backup e LGPD, art. 18: portabilidade).
+
+Gera um .zip com uma planilha (.csv) para cada tipo de dado da pessoa e um LEIA-ME.txt.
+As planilhas abrem direto no Excel e no Google Planilhas em português: separador ";", vírgula
+decimal e UTF-8 com BOM (para os acentos aparecerem certos).
+
+Só entram os dados da própria pessoa. A senha não entra (o Django só guarda um hash dela) e
+dos amigos não sai nada.
+"""
+import csv
+import io
+import zipfile
+from decimal import Decimal
+
+from django.utils import timezone
+
+from saude.models import (
+    DiarioConsumo,
+    EsporteUsuario,
+    FichaTreino,
+    HistoricoMedida,
+    MetaNutricional,
+    RegistroRefeicaoItem,
+    RegistroXP,
+    SerieExecutada,
+    SessaoAtividade,
+)
+
+LEIA_ME = """Seus dados no BioForm
+=====================
+
+Arquivo gerado em {gerado} para {nome} ({email}).
+
+Cada arquivo .csv é uma planilha. Abra com o Excel, o Google Planilhas ou o LibreOffice.
+
+  perfil.csv      seus dados pessoais e de corpo
+  pesagens.csv    cada peso registrado, com o objetivo da época
+  metas.csv       as metas de calorias, macros e água calculadas para você
+  esportes.csv    os esportes da sua rotina
+  series.csv      as suas séries de academia e os exercícios de cada uma
+  treinos.csv     cada treino registrado (academia, corrida e qualquer outro)
+  series_feitas.csv  cada série feita nos treinos, com carga e repetições
+  diario.csv      cada alimento registrado no diário
+  dias.csv        água e "dieta perfeita" de cada dia do diário
+  xp.csv          os pontos de experiência ganhos
+
+A sua senha não está no arquivo: o BioForm guarda só uma versão embaralhada dela.
+Para apagar tudo, use "Excluir conta" em Editar perfil.
+"""
+
+
+def numero(valor, casas=None):
+    """Número com vírgula decimal (padrão brasileiro); vazio quando não há valor."""
+    if valor is None or valor == '':
+        return ''
+    if casas is not None:
+        valor = Decimal(valor).quantize(Decimal(1).scaleb(-casas))
+    texto = str(valor)
+    if '.' in texto:
+        texto = texto.rstrip('0').rstrip('.')
+    return texto.replace('.', ',')
+
+
+def data(valor):
+    return valor.strftime('%d/%m/%Y') if valor else ''
+
+
+def data_hora(valor):
+    return timezone.localtime(valor).strftime('%d/%m/%Y %H:%M') if valor else ''
+
+
+def sim_nao(valor):
+    return 'sim' if valor else 'não'
+
+
+def planilha(cabecalho, linhas):
+    """O texto de um .csv: UTF-8 com BOM, separador ;"""
+    saida = io.StringIO()
+    escritor = csv.writer(saida, delimiter=';', lineterminator='\r\n')
+    escritor.writerow(cabecalho)
+    escritor.writerows(linhas)
+    return '﻿' + saida.getvalue()
+
+
+# =====================================================================
+# Uma função por planilha: devolve (cabeçalho, linhas)
+# =====================================================================
+
+def perfil(usuario):
+    conta = usuario.conta
+    linhas = [
+        ('Nome completo', usuario.nome_completo),
+        ('Apelido', usuario.apelido),
+        ('E-mail', conta.email),
+        ('CPF', usuario.cpf),
+        ('Celular', usuario.celular),
+        ('Data de nascimento', data(usuario.data_nascimento)),
+        ('Sexo biológico', usuario.get_sexo_biologico_display() if usuario.sexo_biologico else ''),
+        ('Altura (cm)', numero(usuario.altura_cm)),
+        ('Biotipo', usuario.get_biotipo_display() if usuario.biotipo else ''),
+        ('Peso desejado (kg)', numero(usuario.peso_meta_kg)),
+        ('Aceitou os termos', sim_nao(usuario.aceitou_termos)),
+        ('Cadastro em', data_hora(usuario.data_cadastro)),
+    ]
+    return ('Campo', 'Valor'), linhas
+
+
+def pesagens(usuario):
+    linhas = [
+        (data_hora(m.data_registro), numero(m.peso_kg), m.get_objetivo_momento_display())
+        for m in HistoricoMedida.objects.filter(usuario=usuario).order_by('data_registro')
+    ]
+    return ('Data', 'Peso (kg)', 'Objetivo'), linhas
+
+
+def metas(usuario):
+    linhas = [
+        (data(m.data_inicio), m.meta_calorias, numero(m.meta_proteina_g), numero(m.meta_carbo_g),
+         numero(m.meta_gordura_g), m.meta_agua_ml)
+        for m in MetaNutricional.objects.filter(usuario=usuario).order_by('data_inicio')
+    ]
+    return ('Válida desde', 'Calorias (kcal)', 'Proteína (g)', 'Carboidratos (g)', 'Gorduras (g)', 'Água (ml)'), linhas
+
+
+def esportes(usuario):
+    linhas = [
+        (e.esporte.nome, e.frequencia_semanal, e.get_intensidade_display(), e.duracao_minutos, e.dias_fixos)
+        for e in EsporteUsuario.objects.filter(usuario=usuario).select_related('esporte').order_by('esporte__nome')
+    ]
+    return ('Esporte', 'Vezes por semana', 'Intensidade', 'Minutos', 'Dias fixos'), linhas
+
+
+def series_de_academia(usuario):
+    linhas = []
+    for ficha in FichaTreino.objects.filter(usuario=usuario).order_by('nome_ficha'):
+        for e in ficha.exercicios.order_by('ordem_execucao'):
+            linhas.append((
+                ficha.nome_ficha, ficha.dias_semana, sim_nao(ficha.ativa), e.ordem_execucao, e.nome_exercicio,
+                e.series_planejadas, e.repeticoes_planejadas or '', e.tempo_segundos or '', numero(e.carga_kg),
+                e.intervalo_segundos or '',
+            ))
+    return ('Série', 'Dias', 'Ativa', 'Ordem', 'Exercício', 'Séries', 'Repetições', 'Tempo (s)', 'Carga (kg)',
+            'Intervalo (s)'), linhas
+
+
+def treinos(usuario):
+    linhas = [
+        (data_hora(s.inicio), s.titulo, s.esporte.nome, s.duracao_minutos, s.get_intensidade_display(),
+         numero(s.distancia_km), s.observacoes)
+        for s in SessaoAtividade.objects.filter(usuario=usuario).select_related('esporte', 'ficha').order_by('inicio')
+    ]
+    return ('Início', 'Treino', 'Esporte', 'Duração (min)', 'Intensidade', 'Distância (km)', 'Observações'), linhas
+
+
+def series_feitas(usuario):
+    linhas = [
+        (data_hora(s.sessao.inicio), s.sessao.titulo, s.nome_exercicio, s.numero_serie, numero(s.carga_kg),
+         s.repeticoes or '', s.tempo_segundos or '')
+        for s in SerieExecutada.objects.filter(sessao__usuario=usuario)
+        .select_related('sessao__esporte', 'sessao__ficha').order_by('sessao__inicio', 'ordem', 'numero_serie')
+    ]
+    return ('Treino em', 'Treino', 'Exercício', 'Série', 'Carga (kg)', 'Repetições', 'Tempo (s)'), linhas
+
+
+def diario(usuario):
+    itens = (
+        RegistroRefeicaoItem.objects.filter(registro__diario__usuario=usuario)
+        .select_related('registro__diario', 'alimento', 'medida_caseira')
+        .order_by('registro__diario__data_referencia', 'registro__horario')
+    )
+    linhas = []
+    for item in itens:
+        macros = item.macros()
+        linhas.append((
+            data(item.registro.diario.data_referencia), item.registro.get_tipo_refeicao_display(), item.alimento.nome,
+            numero(item.quantidade), item.medida_caseira.nome if item.medida_caseira else 'porção',
+            numero(item.gramas(), 0), numero(macros['kcal'], 0), numero(macros['proteina_g'], 1),
+            numero(macros['carbo_g'], 1), numero(macros['gordura_g'], 1),
+        ))
+    return ('Data', 'Refeição', 'Alimento', 'Quantidade', 'Medida', 'Gramas', 'Calorias (kcal)', 'Proteína (g)',
+            'Carboidratos (g)', 'Gorduras (g)'), linhas
+
+
+def dias(usuario):
+    linhas = [
+        (data(d.data_referencia), d.total_agua_consumida_ml, sim_nao(d.status_dieta_cumprida))
+        for d in DiarioConsumo.objects.filter(usuario=usuario).order_by('data_referencia')
+    ]
+    return ('Data', 'Água (ml)', 'Dieta perfeita'), linhas
+
+
+def xp(usuario):
+    linhas = [
+        (data(r.data_referencia), r.get_acao_display(), r.pontos)
+        for r in RegistroXP.objects.filter(usuario=usuario).order_by('data_referencia', 'criado_em')
+    ]
+    return ('Data', 'Ação', 'Pontos'), linhas
+
+
+PLANILHAS = [
+    ('perfil.csv', perfil), ('pesagens.csv', pesagens), ('metas.csv', metas), ('esportes.csv', esportes),
+    ('series.csv', series_de_academia), ('treinos.csv', treinos), ('series_feitas.csv', series_feitas),
+    ('diario.csv', diario), ('dias.csv', dias), ('xp.csv', xp),
+]
+
+
+def nome_do_arquivo(usuario, hoje=None):
+    hoje = hoje or timezone.localdate()
+    return 'bioform-meus-dados-%s.zip' % hoje.strftime('%Y-%m-%d')
+
+
+def gerar_zip(usuario):
+    """Os bytes do .zip com todas as planilhas da pessoa e o LEIA-ME."""
+    memoria = io.BytesIO()
+    with zipfile.ZipFile(memoria, 'w', zipfile.ZIP_DEFLATED) as arquivo:
+        arquivo.writestr('LEIA-ME.txt', LEIA_ME.format(
+            gerado=timezone.localtime().strftime('%d/%m/%Y às %H:%M'), nome=usuario.nome_completo,
+            email=usuario.conta.email,
+        ))
+        for nome, funcao in PLANILHAS:
+            cabecalho, linhas = funcao(usuario)
+            arquivo.writestr(nome, planilha(cabecalho, linhas))
+    return memoria.getvalue()
