+"""Baixar meus dados (RNF12 / LGPD): contas/exportar.py e a view contas:exportar_dados."""
+import io
+import zipfile
+from datetime import date, timedelta
+from decimal import Decimal
+
+from django.contrib.auth import get_user_model
+from django.test import TestCase
+from django.urls import reverse
+from django.utils import timezone
+
+from diario import servicos as diario
+from metas.calculo import salvar_meta
+from saude.models import Alimento, Esporte, HistoricoMedida, SerieExecutada, SessaoAtividade, Usuario
+
+from .exportar import PLANILHAS, numero
+
+SENHA = 'exportar-bioform-2026'
+
+
+def criar_usuario(email, cpf, nome):
+    conta = get_user_model().objects.create_user(username=email, email=email, password=SENHA)
+    usuario = Usuario.objects.create(
+        conta=conta, nome_completo=nome, apelido=nome.split()[0], cpf=cpf, celular='21999990000',
+        data_nascimento=date(1995, 3, 2), sexo_biologico='feminino', altura_cm=165, biotipo='mesomorfo',
+        rotina_confirmada_em=timezone.localdate(), aceitou_termos=True,
+    )
+    HistoricoMedida.objects.create(usuario=usuario, data_registro=timezone.now(), peso_kg=Decimal('63.5'),
+                                   objetivo_momento='saude')
+    salvar_meta(usuario)
+    return usuario
+
+
+class ExportarDadosTest(TestCase):
+    def setUp(self):
+        self.ana = criar_usuario('ana@email.com', '52998224725', 'Ana Souza')
+        self.bia = criar_usuario('bia@email.com', '11144477735', 'Beatriz Lima')
+        ontem = timezone.localdate() - timedelta(days=1)
+        arroz = Alimento.objects.filter(nome__istartswith='Arroz, tipo 1, cozido').first()
+        feijao = Alimento.objects.filter(nome__istartswith='Feijão, carioca, cozido').first()
+        diario.registrar_item(self.ana, ontem, 'almoco', arroz, Decimal('1.5'))
+        diario.adicionar_agua(self.ana, ontem, 1800)
+        diario.registrar_item(self.bia, ontem, 'jantar', feijao, Decimal('1'))
+        corrida = Esporte.objects.get(nome='Corrida')
+        sessao = SessaoAtividade.objects.create(
+            usuario=self.ana, esporte=corrida, inicio=timezone.now() - timedelta(days=2), duracao_minutos=35,
+            intensidade='moderada', nome='Corrida da Ana', distancia_km=Decimal('5.25'), observacoes='Joelho ok',
+        )
+        SerieExecutada.objects.create(sessao=sessao, nome_exercicio='Prancha', numero_serie=1, carga_kg=0,
+                                      tempo_segundos=40)
+        SessaoAtividade.objects.create(usuario=self.bia, esporte=corrida, inicio=timezone.now(), duracao_minutos=20,
+                                       intensidade='leve', nome='Corrida da Bia')
+        self.client.login(username='ana@email.com', password=SENHA)
+
+    def baixar(self):
+        resposta = self.client.get(reverse('contas:exportar_dados'))
+        self.assertEqual(resposta.status_code, 200)
+        arquivo = zipfile.ZipFile(io.BytesIO(resposta.content))
+        return resposta, {nome: arquivo.read(nome).decode('utf-8-sig') for nome in arquivo.namelist()}
+
+    def test_baixa_um_zip_com_todas_as_planilhas(self):
+        resposta, arquivos = self.baixar()
+        self.assertEqual(resposta['Content-Type'], 'application/zip')
+        self.assertIn('attachment; filename="bioform-meus-dados-', resposta['Content-Disposition'])
+        self.assertEqual(resposta['Cache-Control'], 'no-store')
+        self.assertEqual(set(arquivos), {'LEIA-ME.txt'} | {nome for nome, _ in PLANILHAS})
+        self.assertIn('Ana Souza (ana@email.com)', arquivos['LEIA-ME.txt'])
+
+    def test_traz_os_dados_da_pessoa(self):
+        _, arquivos = self.baixar()
+        self.assertIn('Nome completo;Ana Souza', arquivos['perfil.csv'])
+        self.assertIn(';63,5;Saúde', arquivos['pesagens.csv'])
+        self.assertIn('Corrida da Ana;Corrida;35;Moderada;5,25;Joelho ok', arquivos['treinos.csv'])
+        self.assertIn('Corrida da Ana;Prancha;1;0;;40', arquivos['series_feitas.csv'])
+        self.assertIn('Almoço;Arroz, tipo 1, cozido;1,5;porção', arquivos['diario.csv'])
+        self.assertIn(';1800;não', arquivos['dias.csv'])
+        self.assertEqual(len(arquivos['metas.csv'].splitlines()), 2)  # cabeçalho + a meta salva
+
+    def test_nao_traz_dados_de_outra_pessoa(self):
+        _, arquivos = self.baixar()
+        tudo = '\n'.join(arquivos.values())
+        for texto in ('Beatriz', 'bia@email.com', '11144477735', 'Corrida da Bia', 'Feijão'):
+            self.assertNotIn(texto, tudo)
+
+    def test_nao_traz_a_senha(self):
+        _, arquivos = self.baixar()
+        tudo = '\n'.join(arquivos.values())
+        self.assertNotIn(self.ana.conta.password, tudo)
+        self.assertNotIn('pbkdf2', tudo)
+
+    def test_planilha_no_formato_do_excel_em_portugues(self):
+        resposta = self.client.get(reverse('contas:exportar_dados'))
+        arquivo = zipfile.ZipFile(io.BytesIO(resposta.content))
+        bruto = arquivo.read('treinos.csv')
+        self.assertTrue(bruto.startswith('﻿'.encode('utf-8')))  # BOM: acentos certos no Excel
+        self.assertTrue(bruto.decode('utf-8-sig').startswith('Início;Treino;Esporte'))
+
+    def test_pessoa_sem_registros_baixa_planilhas_so_com_cabecalho(self):
+        criar_usuario('nova@email.com', '39053344705', 'Nova Pessoa')
+        self.client.logout()
+        self.client.login(username='nova@email.com', password=SENHA)
+        _, arquivos = self.baixar()
+        self.assertEqual(len(arquivos['treinos.csv'].splitlines()), 1)
+        self.assertEqual(len(arquivos['diario.csv'].splitlines()), 1)
+
+    def test_exige_login(self):
+        self.client.logout()
+        resposta = self.client.get(reverse('contas:exportar_dados'))
+        self.assertEqual(resposta.status_code, 302)
+        self.assertIn('login', resposta.url)
+
+    def test_botao_na_tela_da_conta(self):
+        resposta = self.client.get(reverse('contas:conta'))
+        self.assertContains(resposta, 'Baixar meus dados')
+        self.assertContains(resposta, reverse('contas:exportar_dados'))
+
+    def test_numero_com_virgula(self):
+        self.assertEqual(numero(Decimal('63.50')), '63,5')
+        self.assertEqual(numero(Decimal('120.00')), '120')
+        self.assertEqual(numero(Decimal('12.345'), 1), '12,3')
+        self.assertEqual(numero(None), '')
