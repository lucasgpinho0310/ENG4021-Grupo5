+@perfil_obrigatorio
+def exportar_dados(request, usuario):
+    """Baixar meus dados (RNF12 / LGPD): um .zip com uma planilha para cada tipo de dado da pessoa."""
+    resposta = HttpResponse(exportar.gerar_zip(usuario), content_type='application/zip')
