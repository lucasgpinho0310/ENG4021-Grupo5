+from django import template
+
+from .. import servicos
+
+register = template.Library()
+
+NO_DIARIO = 2  # o diário mostra só as mais importantes; a lista completa fica em /recomendacoes/
+
+
+@register.inclusion_tag('recomendacoes/_no_diario.html')
+def recomendacoes_no_diario(usuario):
+    """Destaque no diário de hoje: as recomendações mais importantes e um link para todas."""
+    todas = servicos.recomendacoes(usuario)
+    return {'recomendacoes': todas[:NO_DIARIO], 'total': len(todas)}
diff --git a/BioForm/Sprint-10/recomendacoes/recomendacoes/tests.py b/BioForm/Sprint-10/recomendacoes/recomendacoes/tests.py
