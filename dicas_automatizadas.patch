+/* Recomendações (RF20): cartões com uma faixa de cor pelo tipo (atenção, dica, parabéns) */
+.rec-lista { display: grid; gap: 12px; margin-top: 8px; }
+.rec {
+  --rec-cor: var(--flame);
+  display: flex;
+  gap: 14px;
+  padding: 16px;
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-left: 4px solid var(--rec-cor);
+  border-radius: 14px;
+}
+.rec-atencao { --rec-cor: var(--danger); }
+.rec-dica { --rec-cor: var(--flame); }
+.rec-parabens { --rec-cor: var(--green); }
+.rec-emoji { font-size: 22px; line-height: 1.2; }
+.rec-corpo { min-width: 0; display: grid; gap: 4px; }
+.rec-corpo h3 { margin: 0; font-size: 15px; font-weight: 700; }
+.rec-corpo p { margin: 0; font-size: 14px; line-height: 1.5; color: var(--text-2); }
+.rec-corpo a { justify-self: start; font-size: 13px; font-weight: 600; color: var(--flame); }
+.rec-aviso {
+  margin: 24px 0 0;
+  padding: 14px 16px;
+  font-size: 13px;
+  line-height: 1.5;
+  color: var(--text-2);
+  background: var(--surface-2);
+  border-radius: 12px;
+}
+
+/* No diário de hoje */
+.rec-diario { display: grid; gap: 10px; margin: 16px 0; }
+.rec-diario-cab { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
+.rec-diario-cab h2 { margin: 0; font-size: 15px; font-weight: 700; }
+.rec-diario-cab a { font-size: 13px; font-weight: 600; color: var(--flame); }
+
+@media (max-width: 640px) {
+  .rec-corpo a, .rec-diario-cab a { display: inline-block; padding: 12px 0; margin: -12px 0; }
+}
