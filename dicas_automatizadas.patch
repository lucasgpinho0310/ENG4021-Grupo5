diff --git a/BioForm/Sprint-10/recomendacoes/recomendacoes/servicos.py b/BioForm/Sprint-10/recomendacoes/recomendacoes/servicos.py
new file mode 100644
index 0000000..49664f4
--- /dev/null
+++ b/BioForm/Sprint-10/recomendacoes/recomendacoes/servicos.py
@@ -0,0 +1,298 @@
+"""
+Recomendações (RF20): dicas simples de organização de treino e alimentação, tiradas dos dados que a
+pessoa já registrou no diário, nos treinos, na rotina e no peso.
+
+Cada regra é uma função que recebe o Contexto (os dados da pessoa já carregados) e devolve uma
+Recomendacao ou None. Para criar uma regra nova: escreva a função e coloque-a em REGRAS.
+
+Cuidados (o requisito diz "sem substituir profissionais"):
+- as dicas são gerais e sempre aparecem com o aviso de que não substituem nutricionista, médico
+  ou profissional de educação física;
+- para menores de 18 anos não há dicas sobre comer mais ou menos calorias nem sobre pesagem;
+- quando faltam dados (sem meta, poucos dias registrados), a regra não diz nada em vez de chutar.
+"""
+from dataclasses import dataclass, field
+from datetime import timedelta
+from decimal import Decimal
+
+from django.utils import timezone
+
+from aderencia.servicos import semana_feita
+from diario.servicos import resumo_do_dia
+from saude.models import EsporteUsuario, HistoricoMedida, SessaoAtividade
+
+# Tipos, na ordem em que aparecem: primeiro o que pede atenção, por último os parabéns
+ATENCAO, DICA, PARABENS = 'atencao', 'dica', 'parabens'
+ORDEM_DOS_TIPOS = {ATENCAO: 0, DICA: 1, PARABENS: 2}
+
+DIAS_ANALISADOS = 7           # dias completos olhados (de ontem para trás); hoje ainda não acabou
+DIAS_DIARIO_PARADO = 3        # sem nada no diário por tantos dias seguidos: lembrete
+PROTEINA_BAIXA = Decimal('0.8')    # abaixo de 80% da meta de proteína...
+DIAS_PROTEINA_BAIXA = 3            # ...em pelo menos 3 dos dias registrados
+AGUA_BAIXA = 50                    # ontem bebeu menos da metade da meta de água
+DIAS_AGUA_BOA = 5                  # bateu a meta de água em 5 dos últimos 7 dias
+DIAS_MINIMOS_CALORIAS = 3          # média de calorias só com pelo menos 3 dias registrados
+CALORIAS_ACIMA = Decimal('1.15')   # média 15% acima da meta (quem quer emagrecer)
+CALORIAS_ABAIXO = Decimal('0.85')  # média 15% abaixo da meta (quem quer ganhar massa)
+CALORIAS_MUITO_ABAIXO = Decimal('0.6')  # comendo bem menos que o necessário, qualquer objetivo
+DIAS_SEM_TREINO = 7
+ADERENCIA_BAIXA = 50               # semana passada fez menos da metade dos treinos previstos
+DIAS_SEM_PESAGEM = 14
+DIAS_DIETA_BOA = 3                 # 3 dias dentro da meta na semana: parabéns
+IDADE_ADULTA = 18
+
+
+@dataclass
+class Recomendacao:
+    chave: str          # nome da regra (testes e CSS)
+    tipo: str           # ATENCAO, DICA ou PARABENS
+    emoji: str
+    titulo: str
+    texto: str
+    link: str = ''      # nome da rota (para {% url %}), opcional
+    link_texto: str = ''
+
+    @property
+    def ordem(self):
+        return ORDEM_DOS_TIPOS[self.tipo]
+
+
+@dataclass
+class Contexto:
+    """Os dados da pessoa, carregados uma vez só para todas as regras."""
+    usuario: object
+    hoje: object
+    dias: list = field(default_factory=list)  # ResumoDoDia de ontem para trás
+
+    @property
+    def adulto(self):
+        idade = self.usuario.idade(self.hoje)
+        return idade is None or idade >= IDADE_ADULTA
+
+    @property
+    def dias_com_itens(self):
+        return [d for d in self.dias if d.tem_itens]
+
+    @property
+    def objetivo(self):
+        medida = self.usuario.medida_atual()
+        return medida.objetivo_momento if medida else None
+
+    @property
+    def tem_esportes(self):
+        return EsporteUsuario.objects.filter(usuario=self.usuario).exists()
+
+
+def carregar_contexto(usuario, hoje=None):
+    hoje = hoje or timezone.localdate()
+    dias = [resumo_do_dia(usuario, hoje - timedelta(days=n)) for n in range(1, DIAS_ANALISADOS + 1)]
+    return Contexto(usuario=usuario, hoje=hoje, dias=dias)
+
+
+def milhar(n):
+    """1802 -> "1.802", como no resto do site."""
+    return '{:,.0f}'.format(n).replace(',', '.')
+
+
+def plural(n, singular, plural_):
+    return '%d %s' % (n, singular if n == 1 else plural_)
+
+
+# =====================================================================
+# Alimentação
+# =====================================================================
+
+def diario_parado(ctx):
+    """Nenhuma refeição registrada nos últimos dias (e a conta não é nova)."""
+    recentes = ctx.dias[:DIAS_DIARIO_PARADO]
+    criada = timezone.localdate(ctx.usuario.data_cadastro) if ctx.usuario.data_cadastro else ctx.hoje
+    if any(d.tem_itens for d in recentes) or (ctx.hoje - criada).days < DIAS_DIARIO_PARADO:
+        return None
+    return Recomendacao(
+        'diario_parado', ATENCAO, '📝', 'Seu diário está parado',
+        'Faz %s sem refeições registradas. Anotar o que você come, mesmo que só as principais '
+        'refeições, é o que deixa as metas e as outras dicas certas.' % plural(DIAS_DIARIO_PARADO, 'dia', 'dias'),
+        'diario:diario_hoje', 'Registrar refeição',
+    )
+
+
+def proteina_baixa(ctx):
+    dias = [d for d in ctx.dias_com_itens if d.alvo('proteina_g')]
+    baixos = [d for d in dias if d.total['proteina_g'] < d.alvo('proteina_g') * PROTEINA_BAIXA]
+    if len(baixos) < DIAS_PROTEINA_BAIXA:
+        return None
+    return Recomendacao(
+        'proteina_baixa', DICA, '🥚', 'Proteína abaixo da meta',
+        'Em %d dos últimos %s registrados você ficou abaixo de 80%% da meta de proteína. Ovos, '
+        'iogurte, feijão, lentilha, frango ou peixe nas refeições principais ajudam a chegar lá.'
+        % (len(baixos), plural(len(dias), 'dia', 'dias')),
+        'diario:diario_hoje', 'Ver o diário',
+    )
+
+
+def agua_ontem(ctx):
+    ontem = ctx.dias[0] if ctx.dias else None
+    if not ontem or not ontem.diario or not ontem.meta or not ontem.meta.meta_agua_ml:
+        return None
+    if ontem.percentual_agua >= AGUA_BAIXA:
+        return None
+    return Recomendacao(
+        'agua_baixa', DICA, '💧', 'Pouca água ontem',
+        'Ontem você bebeu %d%% da meta de água (%s de %s ml). Deixar uma garrafa por perto e beber '
+        'um copo a cada refeição facilita.' % (ontem.percentual_agua, milhar(ontem.agua_ml), milhar(ontem.meta.meta_agua_ml)),
+        'diario:diario_hoje', 'Registrar água',
+    )
+
+
+def agua_em_dia(ctx):
+    dias = sum(1 for d in ctx.dias if d.meta_agua_atingida)
+    if dias < DIAS_AGUA_BOA:
+        return None
+    return Recomendacao(
+        'agua_em_dia', PARABENS, '🏅', 'Hidratação em dia',
+        'Você bateu a meta de água em %d dos últimos %d dias. Continue assim!' % (dias, len(ctx.dias)),
+    )
+
+
+def calorias(ctx):
+    """Média de calorias dos dias registrados comparada com a meta, de acordo com o objetivo."""
+    if not ctx.adulto:
+        return None  # para menores de 18 anos o app não dá dica de comer mais ou menos
+    dias = [d for d in ctx.dias_com_itens if d.alvo('kcal')]
+    if len(dias) < DIAS_MINIMOS_CALORIAS:
+        return None
+    media = sum(d.total['kcal'] for d in dias) / len(dias)
+    meta = sum(d.alvo('kcal') for d in dias) / len(dias)
+    percentual = int(media * 100 / meta)
+    texto_media = 'Nos últimos %d dias registrados você comeu em média %s kcal, %d%% da meta (%s kcal).' % (
+        len(dias), milhar(media), percentual, milhar(meta))
+    if media < meta * CALORIAS_MUITO_ABAIXO:
+        return Recomendacao(
+            'calorias_muito_baixas', ATENCAO, '⚠️', 'Comendo bem menos que o necessário',
+            texto_media + ' Comer muito abaixo do que o corpo gasta pode trazer cansaço e perda de massa '
+            'muscular. Se isso for intencional, vale conversar com um nutricionista.',
+            'diario:diario_hoje', 'Ver o diário',
+        )
+    if ctx.objetivo == 'emagrecimento' and media > meta * CALORIAS_ACIMA:
+        return Recomendacao(
+            'calorias_acima', DICA, '🍽️', 'Calorias acima da meta',
+            texto_media + ' Para emagrecer, o que mais pesa é ficar perto da meta na maioria dos dias. '
+            'Olhar os lanches e as bebidas costuma ser o jeito mais fácil de ajustar.',
+            'diario:diario_historico', 'Ver o histórico',
+        )
+    if ctx.objetivo == 'hipertrofia' and media < meta * CALORIAS_ABAIXO:
+        return Recomendacao(
+            'calorias_abaixo', DICA, '🍽️', 'Calorias abaixo da meta',
+            texto_media + ' Para ganhar massa, o corpo precisa de energia além do treino. Um lanche a '
+            'mais por dia (iogurte com aveia, pão com ovo, banana com pasta de amendoim) já ajuda.',
+            'diario:diario_historico', 'Ver o histórico',
+        )
+    return None
+
+
+def dieta_na_meta(ctx):
+    dias = sum(1 for d in ctx.dias if d.dentro_da_meta)
+    if dias < DIAS_DIETA_BOA:
+        return None
+    return Recomendacao(
+        'dieta_na_meta', PARABENS, '🎯', 'Alimentação na meta',
+        'Em %d dos últimos %d dias você ficou dentro da meta de calorias e macros.' % (dias, len(ctx.dias)),
+    )
+
+
+# =====================================================================
+# Treinos
+# =====================================================================
+
+def dias_desde_ultimo_treino(ctx):
+    ultima = SessaoAtividade.objects.filter(usuario=ctx.usuario).order_by('-inicio').first()
+    if ultima is None:
+        return None
+    return (ctx.hoje - timezone.localdate(ultima.inicio)).days
+
+
+def sem_treino(ctx):
+    if not ctx.tem_esportes:
+        return None
+    dias = dias_desde_ultimo_treino(ctx)
+    if dias is None:
+        return Recomendacao(
+            'primeiro_treino', DICA, '👟', 'Registre seu primeiro treino',
+            'Seu perfil tem esportes, mas nenhum treino registrado ainda. Registrar mostra seu '
+            'progresso e ajusta a meta de calorias do dia.',
+            'treinos:treinos_registrar', 'Registrar treino',
+        )
+    if dias < DIAS_SEM_TREINO:
+        return None
+    return Recomendacao(
+        'sem_treino', ATENCAO, '⏸️', 'Faz %d dias sem treino' % dias,
+        'Voltar devagar vale mais que esperar o momento perfeito: um treino leve ou uma caminhada '
+        'de 20 minutos já contam.',
+        'treinos:treinos_registrar', 'Registrar treino',
+    )
+
+
+def semana_passada(ctx):
+    """Treinos feitos na semana passada comparados com a rotina do perfil."""
+    if not ctx.tem_esportes:
+        return None
+    dias = dias_desde_ultimo_treino(ctx)
+    if dias is None or dias >= DIAS_SEM_TREINO:
+        return None  # a regra sem_treino já fala disso
+    semana = semana_feita(ctx.usuario, ctx.hoje, semanas_atras=1)
+    if semana.aderencia is None:
+        return None
+    feitos = sum(e.contam for e in semana.esportes)
+    if semana.aderencia >= 100:
+        return Recomendacao(
+            'semana_completa', PARABENS, '🔥', 'Semana de treinos completa',
+            'Semana passada você fez todos os %d treinos previstos na sua rotina.' % semana.total_previsto,
+            'aderencia:semana', 'Ver a semana',
+        )
+    if semana.aderencia < ADERENCIA_BAIXA:
+        return Recomendacao(
+            'semana_fraca', DICA, '📅', 'Semana passada ficou pela metade',
+            'Você fez %d de %d treinos previstos. Se a rotina está difícil de cumprir, vale ajustar os '
+            'dias ou a quantidade de treinos no perfil: uma rotina menor e cumprida rende mais.'
+            % (feitos, semana.total_previsto),
+            'rotina:rotina_semana', 'Ajustar a semana',
+        )
+    return None
+
+
+# =====================================================================
+# Peso
+# =====================================================================
+
+def pesagem_atrasada(ctx):
+    if not ctx.adulto:
+        return None
+    ultima = HistoricoMedida.objects.filter(usuario=ctx.usuario).order_by('-data_registro').first()
+    if ultima is None:
+        return None
+    dias = (ctx.hoje - timezone.localdate(ultima.data_registro)).days
+    if dias < DIAS_SEM_PESAGEM:
+        return None
+    return Recomendacao(
+        'pesagem_atrasada', DICA, '⚖️', 'Atualize seu peso',
+        'A última pesagem foi há %d dias. Com o peso atualizado, as metas de calorias e de proteína '
+        'ficam certas para você.' % dias,
+        'evolucao:peso', 'Registrar peso',
+    )
+
+
+REGRAS = [
+    diario_parado, proteina_baixa, agua_ontem, calorias, sem_treino, semana_passada, pesagem_atrasada,
+    agua_em_dia, dieta_na_meta,
+]
+
+
+def recomendacoes(usuario, hoje=None):
+    """As recomendações da pessoa: primeiro as que pedem atenção, depois dicas, por último os parabéns."""
+    ctx = carregar_contexto(usuario, hoje)
+    encontradas = [r for r in (regra(ctx) for regra in REGRAS) if r]
+    if any(r.chave == 'diario_parado' for r in encontradas):
+        # sem refeições recentes, as outras dicas de alimentação seriam sobre dias antigos
+        encontradas = [r for r in encontradas
+                       if r.chave not in ('proteina_baixa', 'calorias_acima', 'calorias_abaixo', 'calorias_muito_baixas')]
+    return sorted(encontradas, key=lambda r: r.ordem)
