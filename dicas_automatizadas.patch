+++ b/BioForm/Sprint-10/recomendacoes/recomendacoes/tests.py
@@ -0,0 +1,266 @@
+from datetime import date, datetime, time, timedelta
+from decimal import Decimal
+
+from django.contrib.auth import get_user_model
+from django.test import TestCase
+from django.urls import reverse
+from django.utils import timezone
+
+from diario import servicos as diario
+from metas.calculo import salvar_meta
+from saude.models import Alimento, Esporte, EsporteUsuario, HistoricoMedida, SessaoAtividade, Usuario
+
+from . import servicos
+from .servicos import ATENCAO, DICA, PARABENS
+
+SENHA = 'dicas-bioform-2026'
+
+
+def criar_usuario(email='caio@email.com', cpf='52998224725', objetivo='hipertrofia', nascimento=date(1995, 3, 2),
+                  conta_antiga=True):
+    conta = get_user_model().objects.create_user(username=email, email=email, password=SENHA)
+    usuario = Usuario.objects.create(
+        conta=conta, nome_completo='Caio Melo', apelido='Caio', cpf=cpf, celular='21999990000',
+        data_nascimento=nascimento, sexo_biologico='masculino', altura_cm=180, biotipo='mesomorfo',
+        rotina_confirmada_em=timezone.localdate(),
+    )
+    HistoricoMedida.objects.create(usuario=usuario, data_registro=timezone.now(), peso_kg=Decimal('80'),
+                                   objetivo_momento=objetivo)
+    salvar_meta(usuario)
+    if conta_antiga:  # contas novas não recebem o lembrete de diário parado
+        Usuario.objects.filter(id=usuario.id).update(data_cadastro=timezone.now() - timedelta(days=30))
+        usuario.refresh_from_db()
+    return usuario
+
+
+def dia(n):
+    """n dias atrás."""
+    return timezone.localdate() - timedelta(days=n)
+
+
+def momento(n, hora=18):
+    return timezone.make_aware(datetime.combine(dia(n), time(hora)))
+
+
+def arroz():
+    return Alimento.objects.filter(nome__istartswith='Arroz, tipo 1, cozido').first()
+
+
+def frango():
+    return Alimento.objects.filter(nome__istartswith='Frango, peito, sem pele, grelhado').first()
+
+
+def comer(usuario, n, fracao_da_meta, alimento=None):
+    """Registra no dia n (dias atrás) uma quantidade que dá `fracao_da_meta` das calorias da meta do dia."""
+    alimento = alimento or arroz()
+    meta_kcal = diario.resumo_do_dia(usuario, dia(n)).alvo('kcal')
+    porcoes = (meta_kcal * Decimal(fracao_da_meta) / alimento.kcal).quantize(Decimal('0.01'))
+    diario.registrar_item(usuario, dia(n), 'almoco', alimento, porcoes)
+
+
+def chaves(usuario):
+    return [r.chave for r in servicos.recomendacoes(usuario)]
+
+
+def treinar(usuario, n, esporte='Corrida'):
+    SessaoAtividade.objects.create(usuario=usuario, esporte=Esporte.objects.get(nome=esporte), inicio=momento(n),
+                                   duracao_minutos=40, intensidade='moderada')
+
+
+def esporte_no_perfil(usuario, vezes, nome='Corrida', dias='seg'):
+    EsporteUsuario.objects.create(usuario=usuario, esporte=Esporte.objects.get(nome=nome), frequencia_semanal=vezes,
+                                  intensidade='moderada', duracao_minutos=40, dias_fixos=dias)
+
+
+class DiarioTest(TestCase):
+    def test_diario_parado_pede_atencao_e_cala_dicas_de_comida(self):
+        usuario = criar_usuario()
+        for n in range(4, 8):  # comeu pouco há uma semana, nada nos últimos 3 dias
+            comer(usuario, n, '0.3')
+        encontradas = chaves(usuario)
+        self.assertEqual(encontradas[0], 'diario_parado')
+        self.assertNotIn('proteina_baixa', encontradas)
+        self.assertNotIn('calorias_muito_baixas', encontradas)
+
+    def test_conta_nova_nao_recebe_lembrete_de_diario(self):
+        usuario = criar_usuario(conta_antiga=False)
+        self.assertNotIn('diario_parado', chaves(usuario))
+
+    def test_proteina_baixa(self):
+        usuario = criar_usuario()
+        for n in range(1, 5):
+            comer(usuario, n, '0.9')  # só arroz: calorias perto da meta, pouca proteína
+        recomendacao = next(r for r in servicos.recomendacoes(usuario) if r.chave == 'proteina_baixa')
+        self.assertEqual(recomendacao.tipo, DICA)
+        self.assertIn('Em 4 dos últimos 4 dias', recomendacao.texto)
+
+    def test_proteina_em_dia_nao_gera_dica(self):
+        usuario = criar_usuario()
+        for n in range(1, 5):
+            comer(usuario, n, '1', alimento=frango())
+        self.assertNotIn('proteina_baixa', chaves(usuario))
+
+
+class AguaTest(TestCase):
+    def test_pouca_agua_ontem(self):
+        usuario = criar_usuario()
+        diario.adicionar_agua(usuario, dia(1), 300)
+        recomendacao = next(r for r in servicos.recomendacoes(usuario) if r.chave == 'agua_baixa')
+        self.assertIn('(300 de ', recomendacao.texto)
+
+    def test_numeros_com_separador_de_milhar(self):
+        self.assertEqual(servicos.milhar(Decimal('1802.4')), '1.802')
+        self.assertEqual(servicos.milhar(950), '950')
+
+    def test_agua_em_dia_da_parabens(self):
+        usuario = criar_usuario()
+        meta = usuario.meta_atual().meta_agua_ml
+        for n in range(1, 6):
+            diario.adicionar_agua(usuario, dia(n), meta)
+        recomendacoes = servicos.recomendacoes(usuario)
+        self.assertIn('agua_em_dia', [r.chave for r in recomendacoes])
+        self.assertNotIn('agua_baixa', [r.chave for r in recomendacoes])
+        self.assertEqual(recomendacoes[-1].tipo, PARABENS)  # parabéns aparecem por último
+
+
+class CaloriasTest(TestCase):
+    def test_hipertrofia_comendo_abaixo(self):
+        usuario = criar_usuario(objetivo='hipertrofia')
+        for n in range(1, 4):
+            comer(usuario, n, '0.75')
+        self.assertIn('calorias_abaixo', chaves(usuario))
+
+    def test_emagrecimento_comendo_acima(self):
+        usuario = criar_usuario(objetivo='emagrecimento')
+        for n in range(1, 4):
+            comer(usuario, n, '1.3')
+        self.assertIn('calorias_acima', chaves(usuario))
+
+    def test_emagrecimento_abaixo_da_meta_nao_e_problema(self):
+        usuario = criar_usuario(objetivo='emagrecimento')
+        for n in range(1, 4):
+            comer(usuario, n, '0.75')
+        self.assertFalse({'calorias_acima', 'calorias_abaixo', 'calorias_muito_baixas'} & set(chaves(usuario)))
+
+    def test_muito_abaixo_pede_atencao_e_sugere_profissional(self):
+        usuario = criar_usuario(objetivo='emagrecimento')
+        for n in range(1, 4):
+            comer(usuario, n, '0.4')
+        recomendacao = servicos.recomendacoes(usuario)[0]
+        self.assertEqual((recomendacao.chave, recomendacao.tipo), ('calorias_muito_baixas', ATENCAO))
+        self.assertIn('nutricionista', recomendacao.texto)
+
+    def test_poucos_dias_registrados_nao_gera_dica(self):
+        usuario = criar_usuario()
+        for n in range(1, 3):  # só 2 dias: não dá para tirar média
+            comer(usuario, n, '0.4')
+        self.assertFalse({'calorias_abaixo', 'calorias_muito_baixas'} & set(chaves(usuario)))
+
+    def test_menor_de_idade_nao_recebe_dica_de_calorias_nem_de_pesagem(self):
+        hoje = timezone.localdate()
+        usuario = criar_usuario(nascimento=hoje.replace(year=hoje.year - 16))
+        for n in range(1, 4):
+            comer(usuario, n, '0.4')
+        HistoricoMedida.objects.filter(usuario=usuario).update(data_registro=timezone.now() - timedelta(days=30))
+        encontradas = chaves(usuario)
+        self.assertFalse({'calorias_muito_baixas', 'calorias_abaixo', 'pesagem_atrasada'} & set(encontradas))
+
+
+class TreinosTest(TestCase):
+    def test_sem_esportes_no_perfil_nao_fala_de_treino(self):
+        usuario = criar_usuario()
+        self.assertFalse({'primeiro_treino', 'sem_treino', 'semana_fraca'} & set(chaves(usuario)))
+
+    def test_primeiro_treino(self):
+        usuario = criar_usuario()
+        esporte_no_perfil(usuario, 2)
+        self.assertIn('primeiro_treino', chaves(usuario))
+
+    def test_dias_sem_treino(self):
+        usuario = criar_usuario()
+        esporte_no_perfil(usuario, 2)
+        treinar(usuario, 10)
+        recomendacao = next(r for r in servicos.recomendacoes(usuario) if r.chave == 'sem_treino')
+        self.assertEqual(recomendacao.titulo, 'Faz 10 dias sem treino')
+        self.assertEqual(recomendacao.tipo, ATENCAO)
+
+    def test_semana_passada_completa(self):
+        usuario = criar_usuario()
+        esporte_no_perfil(usuario, 1)
+        segunda_passada = timezone.localdate() - timedelta(days=timezone.localdate().weekday() + 7)
+        treinar(usuario, (timezone.localdate() - segunda_passada).days)
+        treinar(usuario, 1)
+        self.assertIn('semana_completa', chaves(usuario))
+
+    def test_semana_passada_pela_metade(self):
+        usuario = criar_usuario()
+        esporte_no_perfil(usuario, 5, dias='seg,ter,qua,qui,sex')
+        segunda_passada = timezone.localdate() - timedelta(days=timezone.localdate().weekday() + 7)
+        treinar(usuario, (timezone.localdate() - segunda_passada).days)
+        treinar(usuario, 1)  # recente: não é o caso de "dias sem treino"
+        recomendacao = next(r for r in servicos.recomendacoes(usuario) if r.chave == 'semana_fraca')
+        self.assertRegex(recomendacao.texto, r'Você fez [12] de 5 treinos previstos')
+
+
+class PesagemTest(TestCase):
+    def test_pesagem_atrasada(self):
+        usuario = criar_usuario()
+        HistoricoMedida.objects.filter(usuario=usuario).update(data_registro=timezone.now() - timedelta(days=20))
+        recomendacao = next(r for r in servicos.recomendacoes(usuario) if r.chave == 'pesagem_atrasada')
+        self.assertIn('há 20 dias', recomendacao.texto)
+        self.assertEqual(recomendacao.link, 'evolucao:peso')
+
+    def test_pesagem_recente_nao_gera_dica(self):
+        self.assertNotIn('pesagem_atrasada', chaves(criar_usuario()))
+
+
+class OrdemTest(TestCase):
+    def test_atencao_antes_de_dica_antes_de_parabens(self):
+        usuario = criar_usuario(objetivo='emagrecimento')
+        esporte_no_perfil(usuario, 2)
+        meta = usuario.meta_atual().meta_agua_ml
+        for n in range(1, 6):
+            comer(usuario, n, '0.9')
+            diario.adicionar_agua(usuario, dia(n), meta)
+        treinar(usuario, 12)
+        tipos = [r.tipo for r in servicos.recomendacoes(usuario)]
+        self.assertEqual(tipos, sorted(tipos, key=servicos.ORDEM_DOS_TIPOS.get))
+        self.assertEqual({ATENCAO, DICA, PARABENS}, set(tipos))
+
+
+class TelasTest(TestCase):
+    def setUp(self):
+        self.usuario = criar_usuario()
+        HistoricoMedida.objects.filter(usuario=self.usuario).update(data_registro=timezone.now() - timedelta(days=20))
+        self.client.login(username='caio@email.com', password=SENHA)
+
+    def test_pagina_mostra_dicas_e_aviso(self):
+        resposta = self.client.get(reverse('recomendacoes:lista'))
+        self.assertContains(resposta, 'Atualize seu peso')
+        self.assertContains(resposta, 'não substituem a orientação de nutricionista')
+        self.assertContains(resposta, reverse('evolucao:peso'))
+
+    def test_pagina_sem_dicas(self):
+        HistoricoMedida.objects.filter(usuario=self.usuario).update(data_registro=timezone.now())
+        Usuario.objects.filter(id=self.usuario.id).update(data_cadastro=timezone.now())
+        resposta = self.client.get(reverse('recomendacoes:lista'))
+        self.assertContains(resposta, 'Nenhuma dica no momento')
+
+    def test_diario_de_hoje_mostra_as_dicas(self):
+        resposta = self.client.get(reverse('diario:diario_hoje'))
+        self.assertContains(resposta, 'Dicas para você')
+        self.assertContains(resposta, 'Atualize seu peso')
+        self.assertContains(resposta, reverse('recomendacoes:lista'))
+
+    def test_diario_de_outro_dia_nao_mostra(self):
+        resposta = self.client.get(reverse('diario:diario_dia', args=[dia(3)]))
+        self.assertNotContains(resposta, 'Dicas para você')
+
+    def test_link_no_menu(self):
+        self.assertContains(self.client.get(reverse('diario:diario_hoje')), '>Dicas</a>')
+
+    def test_exige_login(self):
+        self.client.logout()
+        resposta = self.client.get(reverse('recomendacoes:lista'))
+        self.assertEqual(resposta.status_code, 302)
+        self.assertIn('login', resposta.url)
diff --git a/BioForm/Sprint-10/recomendacoes/recomendacoes/urls.py b/BioForm/Sprint-10/recomendacoes/recomendacoes/urls.py
