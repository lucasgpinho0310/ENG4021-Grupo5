+{% extends 'contas/base_perfil.html' %}
+{% load static %}
+{% block titulo %}Dicas para você{% endblock %}
+{% block estilos_extra %}<link rel="stylesheet" href="{% static 'recomendacoes/css/recomendacoes.css' %}">{% endblock %}
+{% block conteudo %}
+    <h1>Dicas para você</h1>
+    <p class="subtitle">Sugestões a partir do que você registrou nos últimos {{ dias_analisados }} dias no diário, nos treinos e no peso.</p>
+
+    {% if recomendacoes %}
+    <div class="rec-lista">
+      {% for r in recomendacoes %}{% include 'recomendacoes/_cartao.html' with r=r %}{% endfor %}
+    </div>
+    {% else %}
+    <section class="block">
+      <h2 class="block-title">Nenhuma dica no momento</h2>
+      <p class="block-sub">Está tudo em dia, ou ainda faltam registros para o app conseguir sugerir algo. Continue registrando refeições, água, treinos e pesagens.</p>
+    </section>
+    {% endif %}
+
+    <p class="rec-aviso"><strong>Importante:</strong> estas dicas são gerais e geradas automaticamente pelos seus registros. Elas não substituem a orientação de nutricionista, médico ou profissional de educação física. Se tiver alguma condição de saúde, siga o que o seu profissional indicou.</p>
+{% endblock %}
